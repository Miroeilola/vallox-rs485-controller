# --- KiCad ---
*-backups/
*.kicad_prl
*.kicad_pcb-bak
*.kicad_sch-bak
*.net
~*.lck
fp-info-cache
hardware/manufacturing/

# --- ESP-IDF ---
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/managed_components/
firmware/dependencies.lock

# --- ESPHome ---
esphome/secrets.yaml
esphome/.esphome/

# --- CAD ---
*.f3d
*.f3z
mechanical/**/*.stl.tmp

# --- Python / tooling ---
.venv/
__pycache__/
*.pyc

# --- Simulation ---
hardware/sim/out/

# --- OS ---
.DS_Store

# --- host build artefacts ---
firmware/test/host/run_tests
firmware/test/host/run_tests_*
firmware/test/host/*.dSYM
firmware/test/host/panel_host
firmware/test/host/golden/*.actual.png
firmware/test/host/panel-*.png
scripts/vlx-decode/vlx-decode
*.dSYM/

# KiCad MCP scratch (checkpoints, visual diffs, render cache) - never source
hardware/.kicad-mcp/
hardware/.history/
hardware/output/schematic-renders/
hardware/output/netlist.net
hardware/output/board-*.png
hardware/output/board-*.svg

# --- git worktrees ---
.worktrees/

# --- browser simulator (generated) ---
simulator/node_modules/
simulator/dist/
simulator/src/wasm/
simulator/public/board.glb
simulator/public/board-raw.glb
simulator/public/enclosure.glb
simulator/.kicad-3d/
simulator/test_hal_web
simulator/test-results/
simulator/playwright-report/

# regenerable mechanical outputs (scripts in mechanical/draft/ rebuild these)
mechanical/step/pcb.step
mechanical/step/enclosure-assembly-draft.step
mechanical/stl/*-draft.stl
